+# auto_read VAR DEFAULT PROMPT
+# In auto mode: assign DEFAULT to VAR (caller scope) and echo the choice.
+# Otherwise behave like the plain `read -rp PROMPT VAR` it replaces.
+auto_read() {
+    local __av="$1" __ad="$2" __ap="$3"
+    if is_auto; then
