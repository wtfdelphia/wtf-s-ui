+        local ns=$(pick_port "$cur_sub")
+        params="$params -subPort $ns"
+        echo -e "${red}[auto] Sub port ${cur_sub} is already in use (another panel? e.g. 3x-ui on 2096); moving subscriptions to ${ns}.${plain}"
+    fi
