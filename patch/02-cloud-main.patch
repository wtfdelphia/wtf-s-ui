+# t <key> — return the localized message, falling back to English.
+t() {
+    local var="MSG_${lang}_$1"
+    local val="${!var}"
+    if [[ -z "$val" ]]; then
+        var="MSG_en_$1"
+        val="${!var}"
+    fi
+    printf '%s' "$val"
+}
