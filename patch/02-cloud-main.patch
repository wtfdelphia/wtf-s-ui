+	// disable_empty_direct_check has no JSON field; emitting it makes the whole
+	// config unparseable.
+	if _, ok = httpClient["disable_empty_direct_check"]; ok {
+		t.Errorf("disable_empty_direct_check is not a real option, got %v", httpClient)
+	}
+}
