+		delete(client, "certificate")
+		delete(client, "certificate_path")
+	} else {
+		delete(client, "certificate_public_key_sha256")
+	}
+
+	if newClient, err := json.MarshalIndent(client, "", "  "); err == nil {
+		t.Client = newClient
+	}
+}
